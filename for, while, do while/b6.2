#include <stdio.h>
int main(){
    int a,sum=0;
    printf("nhap so a:");
    scanf("%d",&a);
    if(a<0){
        printf("khong la so hoan hao");
        return 1;
    }
    for(int i=1;i<=a;i++){
        if(a%i==0){
            sum+=i;
        }
    }
    if(sum==2*a){
        printf("la so hoan hao");
    }
    else {
        printf("khong la so hoan hao");
    }
    return 0;
}
